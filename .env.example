# Copie para .env.local (desenvolvimento) e cadastre as mesmas chaves na hospedagem.
# Fases e IDs são lidos no build: mudou o valor, faça novo deploy.

NEXT_PUBLIC_SITE_URL=https://www.deboragabrich.com

# true só em produção. Em homologação o site sai com noindex.
PERMITIR_INDEXACAO=false

# true no deploy de produção: o build falha se algum link da Hotmart ainda for marcador.
EXIGIR_LINKS_FINAIS=false

# Fases por página (valor inválido faz o build falhar)
FASE_CURSOS=normal              # normal | lista | bf
FASE_ANTES_DA_FOTO=normal       # normal | abertura | ultima | encerrado
FASE_LUZ_NA_PRATICA=normal      # normal | abertura | ultima | encerrado
FASE_MAIS_QUE_UM_CLICK=normal   # normal | abertura | ultima | encerrado
FASE_NO_ESTUDIO=lista           # lista | vagas
FASE_MENTORIA=unica             # unica

# Rastreamento (vazio = não carrega)
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_HOTMART_PIXEL_ID=
